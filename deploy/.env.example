# message-archive stack .env (names and safe defaults only; never commit real values)
# Host port = container port, assigned by Claude Code from the port register (8070-8099).
PORT_HOST=
# Fast disk for the SQLite database (Tier 1).
FAST_STORAGE=/srv/dev-disk-by-uuid-758425e9-f9ca-4fbc-ad81-eaea80fdfb73/appdata-ssd
# Pool folder for the media store (under docker/, so in Tier 1).
SLOW_STORAGE=/srv/mergerfs/StoragePool/docker
# Backup drop folder on the dump_truck share (agreed with James 2026-11-13). Must be writable by uid 1000 / gid 100.
INBOX_PATH=/srv/mergerfs/StoragePool/dump_truck/AppData/message-archive-inbox
# Plain http on LAN/Tailscale: keep false. Set true only if the app is served over HTTPS.
COOKIE_SECURE=false
# Sign-in lasts this long without use (minutes).
SESSION_IDLE_MINUTES=720
# Inbox scan interval in minutes (0 = only on upload or button). WebDAV uploads import immediately.
SCAN_INTERVAL_MINUTES=15
# Files copied in by hand are imported once unchanged for this many seconds.
SETTLE_SECONDS=120
# Country code used to normalize numbers without one (1 = Canada/US).
DEFAULT_COUNTRY_CODE=1
# Optional: your own number(s), comma separated. Normally learned from the backups.
SELF_NUMBERS=
# Read-only "older than cutoff" preview on the Stats page (Phase 2 uses the same values).
CUTOFF_DAYS=730
KEEP_RECENT_DAYS=30
# Largest single WebDAV upload, in GB.
DAV_MAX_GB=20
LOG_LEVEL=info
